{
  "title": "Welcome to motioncraft",
  "aspect": "16:9",
  "fps": 30,
  "theme": "light",
  "captionStyle": "standard",
  "voice": "af_heart",
  "voiceSpeed": 1.1,
  "pronounce": {
    "motioncraft": "motion craft",
    "Motioncraft": "Motion craft"
  },
  "overlays": [
    {
      "text": "Made with motioncraft",
      "corner": "top-right",
      "scenes": [
        "swap",
        "chart",
        "receipt",
        "code",
        "pipeline",
        "formats"
      ]
    }
  ],
  "scenes": [
    {
      "id": "hook",
      "component": "Headline",
      "props": {
        "lines": [
          {
            "text": "Videos from a prompt.",
            "at": {
              "word": "videos"
            }
          },
          {
            "text": "Every frame.",
            "at": {
              "word": "every frame"
            }
          },
          {
            "text": "In code.",
            "at": {
              "word": "in code"
            }
          }
        ],
        "motion": "words",
        "emphasis": 2
      },
      "narration": "Welcome to motioncraft. Videos from a prompt. Every frame, in code.",
      "transition": {
        "type": "fade",
        "durationMs": 700
      }
    },
    {
      "id": "prompt",
      "component": "PromptCard",
      "props": {
        "text": "A launch video for my app",
        "shareId": "prompt"
      },
      "narration": "You describe the video you want.",
      "durationMs": 3600,
      "transition": {
        "type": "fade",
        "durationMs": 900
      }
    },
    {
      "id": "plan",
      "component": "Handoff",
      "props": {
        "from": {
          "component": "PromptCard",
          "props": {
            "text": "A launch video for my app",
            "shareId": "prompt",
            "typed": false
          }
        },
        "to": {
          "component": "TerminalWindow",
          "props": {
            "title": "render",
            "shareId": "term",
            "lines": [
              {
                "prompt": true,
                "text": "npm run render"
              },
              {
                "text": "launch.mp4 ready"
              }
            ]
          }
        },
        "label": "render"
      },
      "narration": "Your agent writes the storyboard, and one command renders it.",
      "durationMs": 5600,
      "transition": {
        "type": "fade",
        "durationMs": 900
      }
    },
    {
      "id": "render",
      "component": "Notification",
      "props": {
        "notifications": [
          {
            "app": "motioncraft",
            "title": "Render finished",
            "body": "launch.mp4 is ready to post",
            "icon": "check",
            "time": "now"
          }
        ],
        "atMs": [
          900
        ],
        "content": {
          "component": "TerminalWindow",
          "props": {
            "title": "render",
            "shareId": "term",
            "typed": false,
            "lines": [
              {
                "prompt": true,
                "text": "npm run render"
              },
              {
                "text": "launch.mp4 ready"
              }
            ]
          }
        }
      },
      "narration": "It all runs on your machine. No accounts, and no cloud.",
      "durationMs": 5900,
      "transition": {
        "type": "fade",
        "durationMs": 900
      }
    },
    {
      "id": "kit",
      "component": "Pinned",
      "props": {
        "corner": "topLeft",
        "pinned": {
          "component": "TerminalWindow",
          "props": {
            "title": "render",
            "shareId": "term",
            "typed": false,
            "lines": [
              {
                "prompt": true,
                "text": "npm run render"
              },
              {
                "text": "launch.mp4 ready"
              }
            ]
          }
        },
        "content": {
          "component": "FeatureList",
          "props": {
            "title": "A kit of clean pieces",
            "items": [
              {
                "icon": "chart",
                "text": "Charts that build"
              },
              {
                "icon": "sparkles",
                "text": "Smooth transitions"
              },
              {
                "icon": "check",
                "text": "Checked layouts"
              }
            ]
          }
        }
      },
      "narration": "It comes with a kit of clean, animated pieces, ready to use.",
      "durationMs": 6600,
      "transition": {
        "type": "iris",
        "durationMs": 800
      }
    },
    {
      "id": "swap",
      "component": "WordSwap",
      "props": {
        "prefix": "Made for",
        "options": [
          "launches",
          "tutorials",
          "shorts",
          "you"
        ]
      },
      "narration": "Made for launches, tutorials, shorts, and you.",
      "durationMs": 4200,
      "transition": {
        "type": "slide",
        "direction": "left",
        "durationMs": 650
      }
    },
    {
      "id": "chart",
      "component": "BarChart",
      "props": {
        "title": "Signups by month",
        "data": [
          {
            "label": "Jan",
            "value": 480
          },
          {
            "label": "Feb",
            "value": 720
          },
          {
            "label": "Mar",
            "value": 1250,
            "emphasis": true
          },
          {
            "label": "Apr",
            "value": 960
          },
          {
            "label": "May",
            "value": 1100
          }
        ]
      },
      "narration": "Charts build themselves, straight from your numbers.",
      "durationMs": 5200,
      "transition": {
        "type": "slide",
        "direction": "left",
        "durationMs": 650
      }
    },
    {
      "id": "receipt",
      "component": "Receipt",
      "props": {
        "title": "Trattoria Roma",
        "items": [
          {
            "label": "Margherita pizza",
            "amount": 14.5
          },
          {
            "label": "Truffle pasta",
            "amount": 22
          },
          {
            "label": "Caesar salad",
            "amount": 11.25,
            "note": "no croutons"
          },
          {
            "label": "Tiramisu",
            "amount": 8
          }
        ],
        "summary": [
          {
            "label": "Subtotal",
            "amount": 55.75
          },
          {
            "label": "Tip",
            "amount": 10
          }
        ],
        "total": {
          "amount": 65.75
        },
        "highlight": 1
      },
      "narration": "It prints receipts, line by line, for when the story is about money.",
      "durationMs": 7000,
      "transition": {
        "type": "wipe",
        "direction": "left",
        "durationMs": 700
      }
    },
    {
      "id": "compare",
      "component": "BeforeAfter",
      "props": {
        "before": {
          "component": "StepList",
          "props": {
            "items": [
              "Keyframe by hand",
              "Export, again"
            ]
          }
        },
        "after": {
          "component": "StepList",
          "props": {
            "items": [
              "Write one prompt",
              "Render"
            ],
            "highlight": 1
          }
        },
        "beforeLabel": "By hand",
        "afterLabel": "With motioncraft"
      },
      "narration": "Before, every change meant animating by hand. Now it's one prompt, and a render.",
      "transition": {
        "type": "fade",
        "durationMs": 700
      },
      "durationMs": 6000
    },
    {
      "id": "code",
      "component": "Annotate",
      "props": {
        "text": "Every frame is drawn in code",
        "mark": "drawn in code",
        "markStyle": "highlight",
        "note": "no stock footage, no AI video"
      },
      "narration": "No stock footage, and no AI video. Every frame is drawn in code.",
      "transition": {
        "type": "slide",
        "direction": "left",
        "durationMs": 650
      }
    },
    {
      "id": "pipeline",
      "component": "StepList",
      "props": {
        "title": "How it works",
        "items": [
          "Write a storyboard",
          "Check every frame",
          "Render the video"
        ],
        "shareIds": [
          "write",
          "check",
          "render"
        ]
      },
      "narration": "You write a storyboard. It checks every frame, then renders the video.",
      "effects": [
        {
          "target": "check",
          "kind": "ring",
          "at": {
            "word": "checks"
          }
        }
      ],
      "transition": {
        "type": "zoomBlur",
        "durationMs": 700
      },
      "durationMs": 5600
    },
    {
      "id": "formats",
      "component": "CardRow",
      "props": {
        "cards": [
          {
            "icon": "play",
            "title": "Shorts",
            "subtitle": "9:16"
          },
          {
            "icon": "laptop",
            "title": "Widescreen",
            "subtitle": "16:9"
          },
          {
            "icon": "file",
            "title": "Feed posts",
            "subtitle": "4:5"
          }
        ],
        "highlight": 2
      },
      "narration": "Shorts, widescreen, and now four by five, for your feed.",
      "transition": {
        "type": "fade",
        "durationMs": 800
      },
      "durationMs": 5600
    },
    {
      "id": "end",
      "component": "EndCard",
      "props": {
        "name": "motioncraft",
        "line": "Prompt in, video out",
        "accent": "Open source, free forever",
        "cta": {
          "label": "Star it on GitHub",
          "note": "github.com/aakaashkapoor/motioncraft"
        },
        "card": {
          "component": "PromptCard",
          "props": {
            "text": "A launch video for my app",
            "shareId": "prompt-end",
            "typed": false
          }
        }
      },
      "narration": "Motioncraft. Prompt in, video out. Open source, and free forever.",
      "durationMs": 7000
    }
  ]
}
