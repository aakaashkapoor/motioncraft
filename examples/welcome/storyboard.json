{
  "title": "Welcome to motioncraft",
  "aspect": "16:9",
  "fps": 30,
  "theme": "light",
  "captionStyle": "standard",
  "voice": "af_heart",
  "voiceSpeed": 1.1,
  "pronounce": {
    "motioncraft": "motion craft",
    "Motioncraft": "Motion craft"
  },
  "overlays": [
    {
      "text": "Made with motioncraft",
      "corner": "top-right",
      "scenes": [
        "swap",
        "chart",
        "receipt",
        "code",
        "pipeline",
        "formats"
      ]
    }
  ],
  "scenes": [
    {
      "id": "hook",
      "component": "Headline",
      "props": {
        "lines": [
          {
            "text": "Videos from a prompt.",
            "at": {
              "word": "videos"
            }
          },
          {
            "text": "Every frame.",
            "at": {
              "word": "every frame"
            }
          },
          {
            "text": "In code.",
            "at": {
              "word": "in code"
            }
          }
        ],
        "motion": "words",
        "emphasis": 2
      },
      "narration": "Welcome to motioncraft. Videos from a prompt, with every frame drawn in code.",
      "transition": {
        "type": "fade",
        "durationMs": 500
      }
    },
    {
      "id": "prompt",
      "component": "PromptCard",
      "props": {
        "text": "A launch video for my app",
        "shareId": "prompt"
      },
      "narration": "You start by describing the video you want, in a single prompt.",
      "transition": {
        "type": "fade",
        "durationMs": 600
      }
    },
    {
      "id": "plan",
      "component": "Handoff",
      "props": {
        "from": {
          "component": "PromptCard",
          "props": {
            "text": "A launch video for my app",
            "shareId": "prompt",
            "typed": false
          }
        },
        "to": {
          "component": "TerminalWindow",
          "props": {
            "title": "render",
            "shareId": "term",
            "lines": [
              {
                "prompt": true,
                "text": "npm run render"
              },
              {
                "text": "launch.mp4 ready"
              }
            ]
          }
        },
        "label": "render"
      },
      "narration": "Your coding agent takes it from there. It writes the storyboard, then runs one command to render it.",
      "transition": {
        "type": "fade",
        "durationMs": 600
      }
    },
    {
      "id": "render",
      "component": "Notification",
      "props": {
        "notifications": [
          {
            "app": "motioncraft",
            "title": "Render finished",
            "body": "launch.mp4 is ready to post",
            "icon": "check",
            "time": "now"
          }
        ],
        "atMs": [
          900
        ],
        "content": {
          "component": "TerminalWindow",
          "props": {
            "title": "render",
            "shareId": "term",
            "typed": false,
            "lines": [
              {
                "prompt": true,
                "text": "npm run render"
              },
              {
                "text": "launch.mp4 ready"
              }
            ]
          }
        }
      },
      "narration": "It checks every frame along the way, and when it's done, it hands you back a finished file, ready to post.",
      "transition": {
        "type": "fade",
        "durationMs": 600
      }
    },
    {
      "id": "kit",
      "component": "Pinned",
      "props": {
        "corner": "topLeft",
        "pinned": {
          "component": "TerminalWindow",
          "props": {
            "title": "render",
            "shareId": "term",
            "typed": false,
            "lines": [
              {
                "prompt": true,
                "text": "npm run render"
              },
              {
                "text": "launch.mp4 ready"
              }
            ]
          }
        },
        "content": {
          "component": "FeatureList",
          "props": {
            "title": "A kit of clean pieces",
            "items": [
              {
                "icon": "chart",
                "text": "Charts that build"
              },
              {
                "icon": "sparkles",
                "text": "Smooth transitions"
              },
              {
                "icon": "check",
                "text": "Checked layouts"
              }
            ]
          }
        }
      },
      "narration": "Under the hood is a kit of clean, animated pieces: charts that build themselves, smooth transitions, and layouts that are checked for you.",
      "transition": {
        "type": "iris",
        "durationMs": 500
      }
    },
    {
      "id": "swap",
      "component": "WordSwap",
      "props": {
        "prefix": "Made for",
        "options": [
          "launches",
          "tutorials",
          "shorts",
          "you"
        ]
      },
      "narration": "It's made for launches, for tutorials, for shorts, and for you.",
      "transition": {
        "type": "slide",
        "direction": "left",
        "durationMs": 500
      }
    },
    {
      "id": "chart",
      "component": "BarChart",
      "props": {
        "title": "Signups by month",
        "data": [
          {
            "label": "Jan",
            "value": 480
          },
          {
            "label": "Feb",
            "value": 720
          },
          {
            "label": "Mar",
            "value": 1250,
            "emphasis": true
          },
          {
            "label": "Apr",
            "value": 960
          },
          {
            "label": "May",
            "value": 1100
          }
        ]
      },
      "narration": "Hand it your numbers, and the charts draw themselves, bar by bar, with the one that matters highlighted.",
      "transition": {
        "type": "slide",
        "direction": "left",
        "durationMs": 500
      }
    },
    {
      "id": "receipt",
      "component": "Receipt",
      "props": {
        "title": "Trattoria Roma",
        "items": [
          {
            "label": "Margherita pizza",
            "amount": 14.5
          },
          {
            "label": "Truffle pasta",
            "amount": 22
          },
          {
            "label": "Caesar salad",
            "amount": 11.25
          }
        ],
        "summary": [
          {
            "label": "Subtotal",
            "amount": 47.75
          },
          {
            "label": "Tip",
            "amount": 10
          }
        ],
        "total": {
          "amount": 57.75
        },
        "highlight": 1
      },
      "narration": "And when the story is about money, it prints the whole receipt for you, line by line, right down to the tip.",
      "transition": {
        "type": "wipe",
        "direction": "left",
        "durationMs": 500
      }
    },
    {
      "id": "compare",
      "component": "BeforeAfter",
      "props": {
        "before": {
          "component": "StepList",
          "props": {
            "items": [
              "Keyframe by hand",
              "Export, again"
            ]
          }
        },
        "after": {
          "component": "StepList",
          "props": {
            "items": [
              "Write one prompt",
              "Render"
            ],
            "highlight": 1
          }
        },
        "beforeLabel": "By hand",
        "afterLabel": "With motioncraft"
      },
      "narration": "No more keyframing by hand, and exporting again and again. Now it's one prompt, and one render.",
      "transition": {
        "type": "fade",
        "durationMs": 500
      }
    },
    {
      "id": "code",
      "component": "Annotate",
      "props": {
        "text": "Every frame is drawn in code",
        "mark": "drawn in code",
        "markStyle": "highlight",
        "note": "no stock footage, no AI video"
      },
      "narration": "There's no stock footage, and no AI video. Every single frame is drawn in code.",
      "transition": {
        "type": "slide",
        "direction": "left",
        "durationMs": 500
      }
    },
    {
      "id": "pipeline",
      "component": "StepList",
      "props": {
        "title": "How it works",
        "items": [
          "Write a storyboard",
          "Check every frame",
          "Render the video"
        ],
        "shareIds": [
          "write",
          "check",
          "render"
        ]
      },
      "narration": "Your agent writes the storyboard, checks every frame, and renders the video, all on its own.",
      "effects": [
        {
          "target": "check",
          "kind": "ring",
          "at": {
            "word": "checks"
          }
        }
      ],
      "transition": {
        "type": "zoomBlur",
        "durationMs": 500
      }
    },
    {
      "id": "formats",
      "component": "CardRow",
      "props": {
        "cards": [
          {
            "icon": "play",
            "title": "Shorts",
            "subtitle": "9:16"
          },
          {
            "icon": "laptop",
            "title": "Widescreen",
            "subtitle": "16:9"
          },
          {
            "icon": "file",
            "title": "Feed posts",
            "subtitle": "4:5"
          }
        ],
        "highlight": 2
      },
      "narration": "Make shorts, widescreen videos and feed posts, all from the same storyboard.",
      "transition": {
        "type": "fade",
        "durationMs": 500
      }
    },
    {
      "id": "end",
      "component": "EndCard",
      "props": {
        "name": "motioncraft",
        "line": "Prompt in, video out",
        "accent": "Open source, free forever",
        "cta": {
          "label": "Star it on GitHub",
          "note": "github.com/aakaashkapoor/motioncraft"
        },
        "card": {
          "component": "PromptCard",
          "props": {
            "text": "A launch video for my app",
            "shareId": "prompt-end",
            "typed": false
          }
        }
      },
      "narration": "Motioncraft. Prompt in, video out. It's open source, and free forever.",
      "durationMs": 7000
    }
  ]
}
