  "theme": "light",
  "scenes": [
    {
      "id": "title",
      "component": "TitleCard",
      "props": { "kicker": "Launch", "title": "Videos from a prompt", "subtitle": "Code-drawn, rendered locally" },
      "narration": "motioncraft turns a prompt into a video.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "card",
      "component": "Card",
      "props": { "icon": "chat", "title": "The prompt", "subtitle": "A launch intro" },
      "narration": "It starts with one prompt.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "label-card",
      "component": "Card",
      "props": { "icon": "check", "title": "Checked" },
      "narration": "Every frame is checked.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "cards",
      "component": "CardRow",
      "props": { "cards": [{ "icon": "file", "title": "Write" }, { "icon": "check", "title": "Check" }, { "icon": "play", "title": "Render" }], "highlight": 1 },
      "narration": "Write, check, then render.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "grid",
      "component": "CardRow",
      "props": {
        "cards": [
          { "icon": "zap", "title": "Fast", "subtitle": "Cached fonts" },
          { "icon": "box", "title": "Small", "subtitle": "No extras" },
          { "icon": "lock", "title": "Local", "subtitle": "No cloud" },
          { "icon": "code", "title": "Code", "subtitle": "Every frame" },
          { "icon": "star", "title": "Ship", "subtitle": "An MP4" }
        ]
      },
      "narration": "Five reasons in a grid.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "number",
      "component": "BigNumber",
      "props": { "value": 100, "suffix": "%", "label": "code-drawn frames" },
      "narration": "No stock footage at all.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "app",
      "component": "AppWindow",
      "props": { "title": "storyboard.json", "content": { "component": "StepList", "props": { "items": ["Hook", "Ask", "Plan", "Demo"], "marker": "dot" } } },
      "narration": "The plan, scene by scene.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "browser",
      "component": "BrowserWindow",
