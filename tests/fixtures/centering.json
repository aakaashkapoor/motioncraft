      "narration": "One command renders it.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "code",
      "component": "CodeWindow",
      "props": { "language": "ts", "code": "const video = await render(storyboard);\nawait save(video, \"intro.mp4\");" },
