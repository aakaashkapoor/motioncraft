      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "chat",
      "component": "ChatWindow",
      "props": {
        "channel": "launch",
        "messages": [
          { "author": "Maya", "time": "9:41", "text": "Intro video for launch?" },
          { "author": "Agent", "badge": "BOT", "time": "9:42", "text": "On it.", "highlight": true }
        ]
      },
      "narration": "Someone asks for a video in chat.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "features",
      "component": "FeatureList",
      "props": { "items": [{ "icon": "lock", "text": "Runs locally" }, { "icon": "code", "text": "Every frame is code" }, { "icon": "check", "text": "Checked before render" }] },
      "narration": "Local, code-drawn and checked.",
      "durationMs": 7000,
      "transition": { "type": "fade" }
    },
    {
      "id": "pinned",
      "component": "Pinned",
      "props": {
        "arrive": "animate",
        "pinned": { "component": "TerminalWindow", "props": { "lines": [{ "prompt": true, "text": "npm test" }, { "text": "42 passed" }] } },
        "content": { "component": "CardRow", "props": { "cards": [{ "icon": "check", "title": "All green" }, { "icon": "clock", "title": "Under a minute" }] } }
      },
      "narration": "All tests pass in under a minute.",
      "durationMs": 7000
    }
